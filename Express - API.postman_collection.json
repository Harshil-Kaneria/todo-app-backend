{
	"info": {
		"_postman_id": "0132da5a-f98e-4a0f-b312-aec809da0d2d",
		"name": "Express - API",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "User",
			"item": [
				{
					"name": "Get User Data",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									""
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "GET",
						"header": [
							{
								"key": "x-token",
								"value": "{{token}}",
								"type": "default"
							}
						],
						"url": {
							"raw": "{{url}}/api/user-details",
							"host": [
								"{{url}}"
							],
							"path": [
								"api",
								"user-details"
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "Auth",
			"item": [
				{
					"name": "User Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {\r",
									"    pm.collectionVariables.set(\"token\", '');\r",
									"    pm.response.to.have.status(200);\r",
									"    var responseBody = pm.response.json();\r",
									"    var token = responseBody.token;\r",
									"    pm.collectionVariables.set(\"token\", token);\r",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\r\n    \"email\": \"xyz@xyz.xyz\",\r\n    \"password\": \"Developer@12345\"\r\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{url}}/public/api/login",
							"host": [
								"{{url}}"
							],
							"path": [
								"public",
								"api",
								"login"
							]
						}
					},
					"response": []
				},
				{
					"name": "User Registration",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\r\n    \"firstName\": \"abc\",\r\n    \"lastName\": \"xyz\",\r\n    \"email\": \"xyz@xyz.xyz\",\r\n    \"password\": \"Developer@12345\"\r\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{url}}/public/api/register",
							"host": [
								"{{url}}"
							],
							"path": [
								"public",
								"api",
								"register"
							]
						}
					},
					"response": []
				}
			]
		}
	],
	"variable": [
		{
			"key": "token",
			"value": ""
		}
	]
}